NODE_ENV=production
PORT=8080

# Vercel production URL, for links/OAuth redirects/referrals.
FRONTEND_DOMAIN=https://gigo.vercel.app

# Required for Firestore on Render. Paste the full Firebase service account JSON
# as one env var in Render, or use the split vars below instead.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GEMINI_API_KEY=your-gemini-api-key

# Optional integrations used by specific backend routes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://gigo.vercel.app/oauth-callback
# PAYSTACK_SECRET_KEY=
# ZAPIER_WEBHOOK_URL=
